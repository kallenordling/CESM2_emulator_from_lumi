# Python build artefacts
__pycache__/
*.pyc
*.pyo

# Ad-hoc diagnostic plots generated by diag_*/plot_* scripts.
# Force-add a specific figure with `git add -f name.png` if you want it tracked.
*.png

# Local eval mirror (summaries copied from /scratch by run_eval_aero.sh)
eval_output/

# Claude Code — personal local overrides (permission rules, hook wiring).
# Skills/agents/hooks under .claude/ are shared; settings.local.json is not.
.claude/settings.local.json

# Editor / OS
.DS_Store
*.swp
notebook_output/

# Superseded figures and one-off diagnostics, moved aside when plots/ was
# cleaned. Kept on disk so nothing is lost; the tracked ones among them also
# remain in git history at their old plots/ paths. Not re-committed here:
# ~160 MB of mostly regenerable output.
plots/archive/
